#!/usr/bin/env bash
# Public GitHub bootstrap and local installer launcher. All source is readable.
set -Eeuo pipefail
if [[ ${1:-} == --help ]]; then
  echo 'Install VPN Manager Modern: sudo bash Plus'
  echo 'Fresh install: bash Plus --fresh'
  echo 'Restore: bash Plus --restore-url URL [--password-file FILE] [--endpoint IP_OR_DOMAIN]'
  echo 'Source: https://github.com/sansoe2022/VPN_Manager_Modern'
  exit 0
fi
[[ $EUID -eq 0 ]] || { echo 'Run this installer with sudo or as root.' >&2; exit 1; }
bootstrap_source=${BASH_SOURCE[0]:-}
if [[ -n "$bootstrap_source" ]]; then
  bootstrap_root=$(cd -- "$(dirname -- "$bootstrap_source")" && pwd)
else
  # A streamed public installer must fetch current source, not reuse an old CWD.
  bootstrap_root=''
fi
if [[ -n "$bootstrap_root" && -f "$bootstrap_root/install.sh" && -f "$bootstrap_root/vpnmanager/manager.py" ]]; then
  exec bash "$bootstrap_root/install.sh" "$@"
fi
export DEBIAN_FRONTEND=noninteractive
export LC_ALL=C.UTF-8
apt-get -o Acquire::Retries=3 update
apt-get -o Acquire::Retries=3 install -y --no-install-recommends git ca-certificates
bootstrap_dir=$(mktemp -d -t vpnmanager-install.XXXXXXXX)
trap 'rm -rf -- "$bootstrap_dir"' EXIT
git clone --depth 1 https://github.com/sansoe2022/VPN_Manager_Modern.git "$bootstrap_dir/source"
bash "$bootstrap_dir/source/install.sh" "$@"
